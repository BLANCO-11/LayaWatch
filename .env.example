# LayaWatch environment template — copy to .env and edit:
#   cp .env.example .env
#
# .env is loaded by `python -m layawatch` at boot (repo root), is gitignored and
# dockerignored — never committed, never baked into the image. Real environment
# variables always override values in this file.
# Format: KEY=VALUE, one per line, no quotes. Lines starting with # are comments.

# First-run owner bootstrap (docs/api-reference.md section 10): applies ONLY on a
# fresh state dir — ignored once any user exists. Format: email:password
# (policy: >=12 chars, not a common password, no email local-part).
LAYWATCH_BOOTSTRAP_OWNER=you@example.com:ChangeMe-123456

# Runtime state lives here (repo-relative), keeping the repo root code-only.
LAYA_STATE_DIR=data

# English-only deployment: english checkpoint only, non-English states -> 422.
LAYA_MODELS=english
LAYA_ENGLISH_ONLY=1

# Other knobs — full table: docs/architecture.md section 6. Defaults shown commented:
# LAYWATCH_BIND=127.0.0.1
# LAYA_PORT=8050
# LAYWATCH_LOG_LEVEL=info
# LAYWATCH_RETENTION_DAYS=7
# LAYWATCH_RETENTION_TRACES=10000
# LAYWATCH_TRACE_SAMPLE=1.0
# LAYWATCH_CAPTURE_PAYLOADS=0
# LAYWATCH_TRUST_PROXY=0
# LAYWATCH_RATELIMIT_ENABLED=1
